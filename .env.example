# ==============================================================================
# INDRA ? Sovereign Industrial AI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Production Client)
# ------------------------------------------------------------------------------
# URL of your production FastAPI backend (leave blank for local dev proxy)
VITE_API_URL=https://your-indra-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Production Server / Docker / Render / Railway)
# ------------------------------------------------------------------------------
# Environment mode: "production" | "development" | "demo"
ENVIRONMENT=production
DEBUG=false

# Allowed CORS origins (comma-separated list of your Vercel domains)
CORS_ORIGINS=https://your-indra-frontend.vercel.app,http://localhost:5173

# Database URL: Hosted PostgreSQL connection string (fallback: embedded SQLite)
DATABASE_URL=postgresql://postgres:password@your-db-host.com:5432/indra_db

# Persistent Vector Database: Hosted Qdrant URL & API Key (fallback: Sovereign RAG)
QDRANT_URL=https://your-cluster-id.qdrant.tech:6333
QDRANT_API_KEY=your-qdrant-api-key

# AI Provider: "auto" | "mock" | "local" | "ollama" | "openai" | "deepseek"
AI_PROVIDER=auto
LOCAL_LLM_MODEL=deepseek-r1:14b
LOCAL_VLM_MODEL=llama3.2-vision:11b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Remote Enterprise AI Provider (optional for hybrid deployments)
REMOTE_AI_API_KEY=
REMOTE_AI_BASE_URL=https://api.deepseek.com/v1

# Storage Provider: "local" | "production"
STORAGE_PROVIDER=production
MAX_FILE_SIZE_MB=50

# JWT & Session Secret
JWT_SECRET=sovereign-indra-super-secret-key-production-2026
